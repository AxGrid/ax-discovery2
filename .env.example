# discovery2 configuration. Copy to `.env` and adjust.
# Already-set process env vars override these values.

# --- HTTP ---
DISCOVERY_LISTEN=:8500

# --- Storage ---
DISCOVERY_DB=./discovery.db

# --- Cluster (gossip) ---
DISCOVERY_NODE_ID=node-1
DISCOVERY_GOSSIP_BIND=0.0.0.0
DISCOVERY_GOSSIP_PORT=7946
# Comma-separated host:port of peer seeds; leave empty for single-node.
DISCOVERY_SEEDS=
# Optional: shared secret for /cluster/snapshot anti-entropy (HTTP pull).
# Strongly recommended in a real cluster — without it any host that can reach
# the API port can pull the full state.
DISCOVERY_CLUSTER_TOKEN=
# Optional: encrypt + authenticate gossip traffic. base64 of 16/24/32 random
# bytes (AES-128/192/256); every node in the cluster must share the same value.
# Generate one with:  openssl rand -base64 32
DISCOVERY_GOSSIP_SECRET=

# --- Discovery / load balancing ---
# Idle timeout (seconds) for sticky-token bindings on
# GET /v1/discover/{name}/pick?token=… . Each pick slides the window forward;
# once a token goes quiet past it, the binding is swept and re-balanced.
# Bindings are persisted (survive restart) and replicated across the cluster.
DISCOVERY_AFFINITY_TTL=1200

# --- Auth: corp-ui SSO ---
# Users live in corp-ui — there are no local accounts. Without CORP_URL the
# UI shows a fallback message and only static service tokens work.
#
# CORP_URL          base URL of the corp-ui console.
# CORP_API_KEY      per-service API key (Admin → Services → Edit → API key).
# CORP_SERVICE_SLUG slug under which this instance is registered.
# CORP_PERM_KEY     permission key in corp-ui that gates discovery actions;
#                   `r` = read, `w` = write, `a`/admin in corp-ui = admin.
CORP_URL=
CORP_API_KEY=
CORP_SERVICE_SLUG=discovery
CORP_PERM_KEY=discovery

# --- Auth: static API tokens (for service-to-service) ---
# Comma-separated. Leave empty to disable. These bypass corp-ui entirely —
# only use for trusted internal callers (CI, discovery2-client, etc.).
DISCOVERY_READ_TOKENS=
DISCOVERY_WRITE_TOKENS=
DISCOVERY_ADMIN_TOKENS=
DISCOVERY_ALLOW_ANON_READ=true

# --- ax-router2 registration (optional) ---
# Exposes the discovery API through an ax-router2 reverse router so it's
# reachable at https://<AX_ROUTER_NAME>.<router-base> without opening the
# service port directly. DISABLED by default — must be explicitly enabled.
#
# Cluster note: every node shares this .env. Do NOT enable the router on more
# than one node — they'd register the same service name and fight over it
# (last-writer-wins kicks the previous node off). `make run-cluster` force-
# disables it; enable it on a single node via `make run-router`.
AX_ROUTER_ENABLE=false
AX_ROUTER_HOST=          # host:port of the router's control port (default 7000)
AX_ROUTER_TOKEN=
AX_ROUTER_NAME=discovery

# --- Logging ---
DISCOVERY_LOG=info

# Note: liveness checks are configured per instance (CheckMode field), not
# globally. Each registered instance picks heartbeat / http / tcp / none.

# --- HTTPS via Let's Encrypt (autocert) ---
# When DISCOVERY_ACME_ENABLE=true, the server runs HTTPS on
# DISCOVERY_HTTPS_LISTEN (default :443) and a small HTTP listener on
# DISCOVERY_ACME_HTTP_LISTEN (default :80) for ACME http-01 challenges +
# redirect. DISCOVERY_LISTEN is ignored in this mode.
#
# Requirements:
#   - public DNS A/AAAA records for every host in DISCOVERY_ACME_DOMAINS
#     pointing at this server,
#   - ports 80 + 443 reachable from the public internet,
#   - the process can bind privileged ports (root, CAP_NET_BIND_SERVICE,
#     or a port-forward).
#   - DISCOVERY_ACME_CACHE must persist across restarts (a real directory
#     on a real volume) — otherwise the server re-issues on every restart
#     and you'll hit Let's Encrypt rate limits.
DISCOVERY_ACME_ENABLE=false
DISCOVERY_ACME_DOMAINS=
DISCOVERY_ACME_EMAIL=
DISCOVERY_ACME_CACHE=./certs
DISCOVERY_HTTPS_LISTEN=:443
DISCOVERY_ACME_HTTP_LISTEN=:80
# Set to "true" to use Let's Encrypt's staging directory while testing
# (untrusted certs, no rate limits). Switch back to false for production.
DISCOVERY_ACME_STAGING=false
