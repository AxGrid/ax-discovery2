/bin/
/discoveryd
.env
/certs/
*.db
ui/dist/assets/
ui/dist/index.html
ui/web/node_modules/
ui/web/dist/
.DS_Store

# Kamal: real secrets must never be committed.
# (Note: .kamal/hooks/ IS committed — those are deploy automation, not secrets.)
/.kamal/secrets
/.kamal/secrets.development
/.kamal/secrets.production

# NOTE: /vendor is committed. The corp-ui SDK is a local-path replace
# (../corp-ui/sdk/go), so it can't be fetched from a proxy — a committed vendor
# tree is the only way `-mod=vendor` (the Dockerfile) builds off this machine.
# After changing deps: `make vendor` then commit the vendor/ delta.

# Local Unsible state (not used; we deploy via Kamal).
/unsible.yaml
